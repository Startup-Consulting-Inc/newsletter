rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // MEDIA FOLDER - Newsletter Images and Assets
    // =========================================================================

    match /media/{fileName} {
      // Anyone can read media files (public access for newsletter images)
      allow read: if true;

      // Only authenticated users can upload media
      // Restrictions:
      // - Must be authenticated
      // - File size limit: 10MB
      // - Must be an image file
      allow write: if request.auth != null &&
                     request.resource.size < 10 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*');

      // Only authenticated users can delete their own uploads
      // Site Admins can delete any media
      allow delete: if request.auth != null;
    }

    // =========================================================================
    // CONTACT UPLOADS FOLDER - Contact Form Attachments
    // =========================================================================

    match /contact-uploads/{fileName} {
      // Anyone can upload attachments for contact forms
      // Restrictions:
      // - File size limit: 10MB
      // - Allowed file types: images (PNG, JPG, JPEG), PDFs, and documents
      allow write: if request.resource.size < 10 * 1024 * 1024 &&
                     (request.resource.contentType.matches('image/.*') ||
                      request.resource.contentType == 'application/pdf' ||
                      request.resource.contentType.matches('application/vnd.*') ||
                      request.resource.contentType.matches('application/.*document.*'));

      // Public read access required for getDownloadURL() to work
      // Security: Download URLs contain unguessable UUIDv4 tokens
      // Files are only accessible by those with the exact URL
      allow read: if true;

      // Only authenticated users can delete attachments
      allow delete: if request.auth != null;
    }

    // =========================================================================
    // DEFAULT DENY - All Other Paths
    // =========================================================================

    // Deny access to any other storage paths not explicitly allowed
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
