{
  "name": "functions",
  "description": "Cloud Functions for Firebase - InNews Newsletter Platform",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "recalculate-stats": "tsx scripts/recalculate-stats.ts"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@types/imap-simple": "^4.2.10",
    "@types/mailparser": "^3.4.6",
    "dotenv": "^17.2.3",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.5.0",
    "html-to-text": "^9.0.0",
    "imap-simple": "^5.1.0",
    "juice": "^10.0.0",
    "mailparser": "^3.9.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.9.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node-fetch": "^2.6.11",
    "@types/nodemailer": "^6.4.14",
    "firebase-functions-test": "^3.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0"
  },
  "private": true
}
